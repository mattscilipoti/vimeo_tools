doctype html
html
  head
    meta charset="utf-8"
    meta name="viewport" content="width=device-width,initial-scale=1"
    = csrf_meta_tags
    = csp_meta_tag
    title Vimeo Tools
    = stylesheet_link_tag "application", "data-turbo-track": "reload"
  body
    nav.navbar
      .nav-links
        - if logged_in?
          = link_to "Overview", "/overview"
          = link_to "Logout", "/logout", data: { turbo_method: :delete }
        - else
          = link_to "Login", "/login"
          = link_to "Sign Up", "/signup"
    .flash-messages
      - flash.each do |type, msg|
        .flash class="flash-#{type}"= msg
    main.container
      = yield

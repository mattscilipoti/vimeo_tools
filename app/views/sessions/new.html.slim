h1 Login

= form_tag "/login", method: :post do
  .field
    = label_tag :email, "Email"
    = email_field_tag :email, params[:email]
  .field
    = label_tag :password, "Password"
    = password_field_tag :password
  = submit_tag "Login"

p
  | Don't have an account?
  = link_to "Sign up", "/signup"
